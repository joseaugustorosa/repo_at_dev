# Copie para .env e preencha. NUNCA versione o .env real.
# Gere valores aleatórios com:  python scripts/bootstrap_env.py

APP_ENV=development
DATABASE_URL=sqlite:///./clinica.db

# >= 32 caracteres, aleatórios (ex.: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=<gerar-valor-aleatorio>
MFA_MASTER_KEY=<gerar-valor-aleatorio>
JWT_ISSUER=clinica-api
JWT_AUDIENCE=clinica-api
ACCESS_TOKEN_TTL_MINUTES=30
BCRYPT_ROUNDS=12

# Cliente M2M do laboratório parceiro (guarde só o HASH bcrypt do segredo)
LAB_CLIENT_ID=laboratorio-parceiro
LAB_CLIENT_SECRET_HASH=<hash-bcrypt-gerado-pelo-bootstrap_env.py>
LAB_ALLOWED_SCOPES=["availability:read"]

# CORS: lista JSON de origens explícitas (nunca "*")
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Rate limiting (tentativas de login/MFA/token por janela)
LOGIN_RATE_LIMIT=5                 # por conta+IP
LOGIN_RATE_LIMIT_PER_IP=20         # por IP
LOGIN_RATE_LIMIT_PER_ACCOUNT=15    # por conta, qualquer IP
LOGIN_RATE_WINDOW_SECONDS=60
DEFAULT_RATE_LIMIT=120

# Em produção: COOKIE_SECURE=true e ENABLE_DOCS=false
COOKIE_SECURE=false
ENABLE_DOCS=true
